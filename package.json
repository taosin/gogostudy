{
  "name": "gogostudy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components content lib tests",
    "test": "npm run test:unit && npm run test:server",
    "test:unit": "tsx --test tests/daily-plan.test.ts tests/question-cache.test.ts tests/study.test.ts tests/use-study.test.ts tests/weekly-report.test.ts tests/geometry-progress.test.ts",
    "test:server": "NODE_OPTIONS=--conditions=react-server tsx --test tests/api.test.ts tests/trusted-writes.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
